# Where2Go merged platform environment

# --- Planning (Vercel / apps/web) ---
AI_PROVIDER_ORDER=google-ai,ollama,openrouter,openai
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
# Browser Maps JS key (HTTP referrer restricted). Required for the interactive map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server Places/Geocoding key. In local dev, apps/web/next.config.ts mirrors NEXT_PUBLIC if this is blank.
GOOGLE_MAPS_API_KEY=
# Optional Map ID for Advanced Markers (create in Cloud Console → Map Management).
NEXT_PUBLIC_GOOGLE_MAP_ID=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
TICKETMASTER_API_KEY=
DATABASE_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth (Clerk — shared web + mobile + safety-api) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Safety API (always-on service — NOT Vercel) ---
SAFETY_API_URL=http://localhost:5000
NEXT_PUBLIC_SAFETY_API_URL=http://localhost:5000
PORT=5000
SAFETY_API_INTERNAL_SECRET=
OPENAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SENTRY_DSN=

# --- Mobile (Expo / EAS) ---
EXPO_PUBLIC_PLANNING_API_URL=http://localhost:3000
EXPO_PUBLIC_SAFETY_API_URL=http://localhost:5000
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Native Google Maps SDK (iOS + Android). Restrict by bundle ID / SHA-1 in Cloud Console.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# App Store / Play policy URLs (shown in Profile)
EXPO_PUBLIC_PRIVACY_URL=https://where2go.app/privacy
EXPO_PUBLIC_TERMS_URL=https://where2go.app/terms

# --- Billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=

# --- Optional fallbacks ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OPENROUTER_API_KEY=
OPENAI_MODEL=
YELP_API_KEY=
